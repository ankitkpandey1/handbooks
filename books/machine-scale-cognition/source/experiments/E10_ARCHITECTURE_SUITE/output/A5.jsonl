{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"[\n  {\n    \"id\": \"swe01\",\n    \"binding_constraint\": \"Authorization behavior is inconsistent and the bypass scope is unproven.\",\n    \"first_action\": \"Capture the exploit, affected route, identities, data, and current authorization path.\",\n    \"machine_work\": \"Type claims as incident evidence or hypothesis; trace helper provenance and call graphs; reproduce with deny-by-default tests; reject unverified blast-radius claims.\",\n    \"selector\": \"Patch the smallest proven bypass, then select systemic escalation only if provenance shows shared helper or repeated-pattern risk.\",\n    \"human_object\": \"Approve emergency exposure containment and the threshold for repository-wide remediation.\",\n    \"stop_authority\": \"Incident owner may stop rollout if access remains possible or evidence is insufficient.\",\n    \"durable_learning\": \"Record the exploit, invariant, affected authorization paths, tests, and escalation decision.\"\n  },\n  {\n    \"id\": \"swe02\",\n    \"binding_constraint\": \"Two failures per week provide too little evidence to classify the cause from retries alone.\",\n    \"first_action\": \"Instrument each run with stable inputs, timing, dependencies, retries, environment, and artifact capture.\",\n    \"machine_work\": \"Build a provenance graph from test assertions through product, test harness, and infrastructure signals; execute controlled reruns and perturbations; reject classifications without discriminating evidence.\",\n    \"selector\": \"Choose product race, test race, or infrastructure noise only when an intervention changes the predicted failure pattern.\",\n    \"human_object\": \"Choose which controlled experiments consume the two-day budget.\",\n    \"stop_authority\": \"Engineer may stop classification and report unresolved uncertainty when interventions are nondiscriminating.\",\n    \"durable_learning\": \"Persist failure signatures, interventions, evidence strength, and unresolved alternatives.\"\n  },\n  {\n    \"id\": \"swe03\",\n    \"binding_constraint\": \"Live consumers require an overlapping compatibility window.\",\n    \"first_action\": \"Inventory every producer, consumer, client, schema assumption, and rollback dependency.\",\n    \"machine_work\": \"Type compatibility claims; construct schema-to-consumer provenance graphs; execute contract, dual-read/write, backfill, and rollback tests; reject unmapped consumers.\",\n    \"selector\": \"Use expand, migrate, observe, and contract only when compatibility evidence passes consumer-specific gates.\",\n    \"human_object\": \"Approve the migration window, risk budget, and deprecation deadline.\",\n    \"stop_authority\": \"Migration owner may halt on contract failure, data divergence, or unowned traffic.\",\n    \"durable_learning\": \"Store the dependency inventory, compatibility matrix, migration evidence, and rollback record.\"\n  },\n  {\n    \"id\": \"swe04\",\n    \"binding_constraint\": \"The latency regression is confounded across six changes and rollback has material cost.\",\n    \"first_action\": \"Freeze further changes and establish a versioned p99 baseline segmented by route, traffic, and dependency.\",\n    \"machine_work\": \"Trace latency claims to deploys and spans; build change-to-path provenance; execute canary, feature-disable, and controlled reversion tests; reject aggregate-only attribution.\",\n    \"selector\": \"Select the smallest reversible change or combination that restores the proven regression segment.\",\n    \"human_object\": \"Prioritize latency recovery against urgent-fix retention.\",\n    \"stop_authority\": \"Incident commander may pause experiments if checkout reliability or customer impact worsens.\",\n    \"durable_learning\": \"Record attribution evidence, segment effects, reversions, and retained-fix rationale.\"\n  },\n  {\n    \"id\": \"swe05\",\n    \"binding_constraint\": \"Security urgency conflicts with serialization compatibility across 18 services.\",\n    \"first_action\": \"Map vulnerable exposure, serialization contracts, traffic paths, and patch-version behavior.\",\n    \"machine_work\": \"Type vulnerability, compatibility, and exploitability claims; build dependency and payload provenance graphs; execute corpus, golden-wire, and staged interoperability tests; reject unsupported upgrade claims.\",\n    \"selector\": \"Select the fastest mitigated path that meets the security gate without untested wire incompatibility.\",\n    \"human_object\": \"Accept residual exposure or authorize emergency isolation and staged rollout.\",\n    \"stop_authority\": \"Security owner may stop deployment on failed payload compatibility or unresolved exploit exposure.\",\n    \"durable_learning\": \"Persist affected assets, payload corpus, test results, mitigations, and exception expiry.\"\n  },\n  {\n    \"id\": \"swe06\",\n    \"binding_constraint\": \"The loss is material but lacks reconciliation and ownership evidence.\",\n    \"first_action\": \"Freeze deletion of source and output evidence and define record identity across pipeline stages.\",\n    \"machine_work\": \"Type observed loss, hypotheses, and unknowns; build record-flow provenance graphs; execute sampled replay and conservation checks; reject inferred ownership or root cause.\",\n    \"selector\": \"Prioritize controls that detect and quarantine loss before optimizing throughput or redesigning components.\",\n    \"human_object\": \"Assign accountable ownership and decide acceptable temporary operating risk.\",\n    \"stop_authority\": \"Operations lead may stop the pipeline if loss exceeds the agreed bound or quarantine fails.\",\n    \"durable_learning\": \"Store reconciliation controls, loss signatures, ownership map, and incident thresholds.\"\n  },\n  {\n    \"id\": \"swe07\",\n    \"binding_constraint\": \"Existing callers need behavioral stability while ambiguity must become explicit.\",\n    \"first_action\": \"Inventory call sites, overload patterns, defect cases, and observable current semantics.\",\n    \"machine_work\": \"Type legacy and intended contracts; build caller-to-behavior provenance; execute compatibility, ambiguity, and migration tests; reject undocumented caller assumptions.\",\n    \"selector\": \"Keep the old method stable and introduce an explicit API path selected by proven ambiguity cases.\",\n    \"human_object\": \"Approve deprecation policy, naming, and migration ownership.\",\n    \"stop_authority\": \"API owner may stop release on compatibility regression or unresolved semantic conflict.\",\n    \"durable_learning\": \"Record contract tests, ambiguity examples, migration telemetry, and deprecation outcomes.\"\n  },\n  {\n    \"id\": \"n01\",\n    \"binding_constraint\": \"Thirty mechanisms and overlapping literature exceed the capacity for unstructured comparison.\",\n    \"first_action\": \"Define conductivity-loss claim types, exclusion rules, and evidence units before selecting experiments.\",\n    \"machine_work\": \"Deduplicate papers and datasets; build mechanism-to-measurement provenance graphs; retrieve only traceable evidence; reject mechanisms lacking discriminating observables.\",\n    \"selector\": \"Select three experiments maximizing discrimination, traceability, and reversibility under stated constraints.\",\n    \"human_object\": \"Approve the evidence threshold and resource allocation among competing mechanisms.\",\n    \"stop_authority\": \"Study lead may stop selection if no experiment separates the leading claims.\",\n    \"durable_learning\": \"Persist the claim taxonomy, deduplication map, rejected nodes, and experiment rationale.\"\n  },\n  {\n    \"id\": \"n02\",\n    \"binding_constraint\": \"The conjecture's graph-class premise may be invalid despite many examples.\",\n    \"first_action\": \"Formalize the graph class, quantifiers, and computational claim independently of the examples.\",\n    \"machine_work\": \"Type definitions, examples, counterexamples, and conjecture implications; build premise-to-result provenance; execute exhaustive bounded searches and invariant checks; reject examples outside the class.\",\n    \"selector\": \"Retain the conjecture only for the verified class and bounds; otherwise emit a corrected or unresolved decision.\",\n    \"human_object\": \"Approve which formalization governs publication or further proof work.\",\n    \"stop_authority\": \"Researcher may stop generalization when premise validation fails.\",\n    \"durable_learning\": \"Store formal definitions, verified examples, counterexamples, and search bounds.\"\n  },\n  {\n    \"id\": \"n03\",\n    \"binding_constraint\": \"Competitor response creates strategic confounding and only two tests are affordable.\",\n    \"first_action\": \"Define the free-tier decision, success metric, guardrails, and competitor-response observables.\",\n    \"machine_work\": \"Type causal assumptions and unknowns; build experiment-to-outcome provenance; execute two reversible tests with holdouts; reject claims not identified by the design.\",\n    \"selector\": \"Choose the test pair maximizing information about conversion, retention, economics, and response risk.\",\n    \"human_object\": \"Set stop-loss thresholds and decide whether strategic ambiguity is tolerable.\",\n    \"stop_authority\": \"Business owner may stop a test on margin, churn, or operational guardrail breach.\",\n    \"durable_learning\": \"Record hypotheses, test design, observed effects, confounders, and next decision boundary.\"\n  },\n  {\n    \"id\": \"n04\",\n    \"binding_constraint\": \"Unknown validation, data, retention, appeal, and legal conditions block a defensible notice.\",\n    \"first_action\": \"Create a fact-and-unknowns register for system purpose, data flows, validation, retention, appeal, and jurisdiction.\",\n    \"machine_work\": \"Type each statement as verified, proposed, or blocked; build notice-claim provenance to controls and owners; retrieve only supplied policy evidence; reject unsupported assurances.\",\n    \"selector\": \"Emit a conditional notice containing only verified practices and explicit unresolved obligations.\",\n    \"human_object\": \"Legal and accountable hiring owners must approve publication and fill blocked controls.\",\n    \"stop_authority\": \"Privacy or legal authority may block issuance if mandatory facts remain unknown.\",\n    \"durable_learning\": \"Maintain the evidence register, control owners, approval record, and revision triggers.\"\n  },\n  {\n    \"id\": \"n05\",\n    \"binding_constraint\": \"One instructor cannot manually individualize and reliably assess 90 learners.\",\n    \"first_action\": \"Define proficiency dimensions, assessment evidence, feedback capacity, and grouping constraints.\",\n    \"machine_work\": \"Type learner claims from baseline assessments; build skill-to-practice provenance; execute adaptive exercises and calibrated scoring; reject unsupported proficiency inferences.\",\n    \"selector\": \"Select low-touch practice and assessment loops that maximize diagnostic value per instructor minute.\",\n    \"human_object\": \"Instructor sets rubric, escalation bands, and acceptable assessment error.\",\n    \"stop_authority\": \"Instructor may stop automation when scoring reliability or learner accessibility fails.\",\n    \"durable_learning\": \"Store rubric versions, item performance, calibration results, and intervention outcomes.\"\n  },\n  {\n    \"id\": \"n06\",\n    \"binding_constraint\": \"Arrivals and downtime are variable, while urgent samples cannot be delayed and capacity is unknown.\",\n    \"first_action\": \"Capture arrival classes, urgency rules, process times, downtime states, and current queue evidence.\",\n    \"machine_work\": \"Type observed capacity versus assumption; build sample-flow provenance; execute scenario and queue simulations using bounded inputs; reject invented capacity or forecast certainty.\",\n    \"selector\": \"Select a priority-aware schedule with protected urgent capacity and downtime contingencies.\",\n    \"human_object\": \"Lab leadership sets clinical priority, safety limits, and escalation thresholds.\",\n    \"stop_authority\": \"Clinical operations authority may suspend the schedule on safety or urgent-delay breach.\",\n    \"durable_learning\": \"Persist queue metrics, scenario assumptions, downtime responses, and threshold breaches.\"\n  },\n  {\n    \"id\": \"n07\",\n    \"binding_constraint\": \"Wayfinding must work across languages, visual impairment, hospital risk, and real navigation behavior.\",\n    \"first_action\": \"Define destinations, language coverage, accessibility requirements, hazards, and measurable navigation tasks.\",\n    \"machine_work\": \"Type user and environmental claims; build destination-to-signage provenance; execute multilingual, low-vision, and route-comprehension tests; reject aesthetic preference as accessibility evidence.\",\n    \"selector\": \"Select the system with the strongest verified comprehension, error recovery, and maintenance performance.\",\n    \"human_object\": \"Hospital stakeholders approve clinical terminology, language governance, and rollout zones.\",\n    \"stop_authority\": \"Accessibility or clinical safety authority may stop deployment on navigation-risk evidence.\",\n    \"durable_learning\": \"Store tested routes, language assets, accessibility findings, and maintenance ownership.\"\n  },\n  {\n    \"id\": \"n08\",\n    \"binding_constraint\": \"Board usefulness must coexist with minority evidence preservation and identity protection.\",\n    \"first_action\": \"Define decision questions, anonymity rules, evidence strata, and acceptable aggregation loss.\",\n    \"machine_work\": \"Type transcript claims by source, confidence, prevalence, and contradiction; build quote-to-theme provenance; execute deduplication and disclosure checks; reject unsupported consensus.\",\n    \"selector\": \"Select recommendations whose support and dissent remain traceable without exposing identities.\",\n    \"human_object\": \"Board sponsor approves risk appetite, minority-evidence treatment, and decision thresholds.\",\n    \"stop_authority\": \"Privacy owner may block publication on re-identification risk.\",\n    \"durable_learning\": \"Retain an anonymized evidence ledger, coding decisions, dissent record, and board outcome.\"\n  },\n  {\n    \"id\": \"n09\",\n    \"binding_constraint\": \"Rapid field change and contaminated evidence can make a map appear more settled than it is.\",\n    \"first_action\": \"Define entities, dataset lineage, benchmark boundaries, time windows, and contradiction criteria.\",\n    \"machine_work\": \"Deduplicate papers, datasets, and benchmarks; build claim-to-data provenance graphs; retrieve and compare primary evidence; reject leakage-tainted or untraceable results.\",\n    \"selector\": \"Select field landmarks by independent replication, provenance quality, and recency without collapsing contradictions.\",\n    \"human_object\": \"Research lead sets inclusion thresholds and decides which unresolved conflicts matter.\",\n    \"stop_authority\": \"Lead may stop synthesis when lineage or benchmark integrity cannot be established.\",\n    \"durable_learning\": \"Maintain the field graph, duplicate clusters, leakage findings, contradiction log, and update cadence.\"\n  },\n  {\n    \"id\": \"n10\",\n    \"binding_constraint\": \"Authored payoff ranges are scenarios, not empirical probabilities.\",\n    \"first_action\": \"Separate empirical inputs, authored ranges, model assumptions, and outcome definitions.\",\n    \"machine_work\": \"Type payoff provenance and uncertainty; build parameter-to-outcome graphs; execute sensitivity, adversarial, and distribution-free simulations; reject probability claims unsupported by data.\",\n    \"selector\": \"Select cooperation conclusions that are robust across admissible ranges, otherwise emit conditional outcomes.\",\n    \"human_object\": \"Model owner decides which scenarios are decision-relevant and what robustness means.\",\n    \"stop_authority\": \"Owner may stop inference when results depend on ungrounded distributions.\",\n    \"durable_learning\": \"Store parameter provenance, sensitivity surfaces, scenario bounds, and robustness status.\"\n  },\n  {\n    \"id\": \"n11\",\n    \"binding_constraint\": \"Severe uncertainty in routes and rainfall makes exact allocation plans unreliable within 72 hours.\",\n    \"first_action\": \"Define protected populations, minimum water needs, staging points, route dependencies, and forecast update triggers.\",\n    \"machine_work\": \"Type verified inventories, assumptions, and forecast scenarios; build source-to-allocation provenance; execute bounded route and shortage computations; reject unverified capacity or access claims.\",\n    \"selector\": \"Choose a modular allocation plan prioritizing life-sustaining need, redundancy, and rapid rerouting.\",\n    \"human_object\": \"Emergency authority sets priority classes, rationing rules, and cross-agency escalation.\",\n    \"stop_authority\": \"Incident commander may stop distribution on safety, contamination, or route-failure evidence.\",\n    \"durable_learning\": \"Record allocations, assumptions, route states, forecast revisions, and unmet-need decisions.\"\n  },\n  {\n    \"id\": \"n12\",\n    \"binding_constraint\": \"One expert-month must be allocated under correlated evidence and unequal reversibility.\",\n    \"first_action\": \"Define bet outcomes, evidence independence, decision value, reversibility, and minimum learning milestones.\",\n    \"machine_work\": \"Type evidence strength and correlation; build bet-to-evidence provenance graphs; execute portfolio allocation and sensitivity computations; reject double-counted support.\",\n    \"selector\": \"Allocate effort to portfolios maximizing information-adjusted option value under the month constraint.\",\n    \"human_object\": \"Portfolio owner sets strategic weights, risk limits, and kill criteria.\",\n    \"stop_authority\": \"Owner may terminate a bet when milestone evidence fails or dependency assumptions break.\",\n    \"durable_learning\": \"Persist evidence-correlation map, allocation rationale, milestone results, and reallocation triggers.\"\n  },\n  {\n    \"id\": \"n13\",\n    \"binding_constraint\": \"The typo is isolated and has no recurrence evidence.\",\n    \"first_action\": \"Verify the exact sentence and intended correction.\",\n    \"machine_work\": \"Type the issue as a local textual defect; trace no broader provenance; apply the single correction; reject recurrence or systemic claims.\",\n    \"selector\": \"Select local correction only; do not escalate.\",\n    \"human_object\": \"Requester confirms the corrected wording if semantic ambiguity remains.\",\n    \"stop_authority\": \"Editor may stop after the typo is corrected and verified.\",\n    \"durable_learning\": \"Record only the corrected sentence and no systemic learning claim.\"\n  }\n]"}}
